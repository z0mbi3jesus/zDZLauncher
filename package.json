{
  "name": "dz-launchpad",
  "version": "0.1.0",
  "description": "A Windows desktop launcher and Workshop mod manager for DayZ",
  "author": "DZ Launchpad",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --external:koffi --outdir=dist-electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "build": "npm run typecheck && npm run test:server-browser && vite build && npm run build:electron && electron-builder --dir --config.directories.output=launcher-build",
    "start": "electron .",
    "package": "npm run typecheck && npm run test:server-browser && vite build && npm run build:electron && electron-builder --config.directories.output=launcher-build",
    "typecheck": "tsc --noEmit --pretty",
    "test:server-browser": "esbuild electron/server-browser.ts --bundle --platform=node --format=esm --external:koffi --outfile=node_modules/.cache/dayz-launchpad-server-browser.mjs && node --test tests/server-browser.test.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zdz.launchpad",
    "productName": "DZ Launchpad",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "launcher-build"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
